#!/usr/bin/env bash
# grove - swap between v1 (stowed ~/.config/quickshell) and v2 (this repo).
# Only one may run: both want the notification server and the session lock.
#
#   grove on        stop v1, start v2
#   grove off       stop v2, start v1
#   grove reload    reload v2 in place
#   grove ipc ...   `qs ipc call ...` on whichever shell is running
#   grove status    which shell runs, with RSS and threads
set -euo pipefail

V2="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)/shell.qml"

# Same environment niri's spawn line gives v1 (minus its plugin import path)
ENV='export QT_FFMPEG_DECODING_HW_DEVICE_TYPES=vaapi; export mesa_glthread=false;'
V1_START='set -a; [ -f ~/.config/quickshell/secrets.env ] && . ~/.config/quickshell/secrets.env; set +a; '"$ENV"' export QML_IMPORT_PATH="$HOME/.config/quickshell/qml:/usr/lib/qt6/bin/:$HOME/.config/quickshell"; exec qs -n -d'
V2_START="$ENV exec qs -p '$V2' -n -d"

v2_pid() { pgrep -x qs -a | grep -- "-p $V2" | awk '{print $1}' | head -n1 || true; }
v1_pid() { pgrep -x qs -a | grep -v -- "-p $V2" | awk '{print $1}' | head -n1 || true; }

spawn() { niri msg action spawn -- bash -c "$1"; }

case "${1:-status}" in
  on)
    qs kill >/dev/null 2>&1 || true
    [ -n "$(v2_pid)" ] || spawn "$V2_START"
    ;;
  off)
    qs kill -p "$V2" >/dev/null 2>&1 || true
    [ -n "$(v1_pid)" ] || spawn "$V1_START"
    ;;
  reload)
    qs ipc -p "$V2" call grove reload
    ;;
  ipc)
    shift
    if [ -n "$(v2_pid)" ]; then qs ipc -p "$V2" call "$@"; else qs ipc call "$@"; fi
    ;;
  status)
    for which in v2 v1; do
      pid=$("${which}_pid")
      [ -n "$pid" ] || continue
      rss=$(awk '/VmRSS/ {printf "%d MB", $2/1024}' "/proc/$pid/status")
      thr=$(awk '/Threads/ {print $2}' "/proc/$pid/status")
      echo "$which running (pid $pid, $rss, $thr threads)"
    done
    [ -n "$(v2_pid)$(v1_pid)" ] || echo "no shell running"
    ;;
  *)
    sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
